{
  "name": "onerpc",
  "version": "0.6.11",
  "description": "The RPC library for the serverless and TypeScript era.",
  "license": "MIT",
  "repository": "https://github.com/raviqqe/onerpc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./adapter/*": {
      "types": "./dist/adapter/*.d.ts",
      "default": "./dist/adapter/*.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "build:tsc": "tsc --emitDeclarationOnly",
    "build:doc": "deno doc --unstable-sloppy-imports --unstable-byonm --html --name='⚡ oneRPC' src/index.ts src/client.ts src/middleware.ts src/validation.ts src/adapter/*.ts",
    "lint": "biome ci",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "@raviqqe/hidash": "^2.0.3",
    "@raviqqe/loscore": "^0.3.0",
    "es-toolkit": "^1.39.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@raviqqe/biome-config": "^2.0.16",
    "@raviqqe/tsconfig": "^3.0.0",
    "@rslib/core": "^0.23.0",
    "@types/aws-lambda": "^8.10.152",
    "@vitest/coverage-v8": "^4.0.1",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "valibot": "^1.3.1",
    "vitest": "^4.0.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "valibot": "^1.3.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
